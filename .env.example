# 花漾集本地运行配置（首次启动会自动复制为 .env）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flower_shop
DB_USER=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

BACKEND_PORT=5303
FRONTEND_PORT=5302
FRONTEND_HOST=127.0.0.1
VITE_BACKEND_TARGET=
CORS_ALLOWED_ORIGINS=
UPLOAD_DIR=uploads

# 正式部署前必须替换，建议使用 48 位以上随机字符。
JWT_SECRET=FlowerShopLocalDemoKey-ChangeBeforeProduction-2026!
JWT_EXPIRE_SECONDS=604800
